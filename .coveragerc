[run]
# The source you want coverage for
source = src/molclusters

# Files to omit from coverage
omit =
    src/molclusters/log.py

# Automatically measure coverage
branch = True

[report]
# Show missing lines in terminal report
show_missing = True
# Ignore missing lines in excluded files
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    # typing-only stubs, never executed
    @overload
    class .*\(Protocol\):

[html]
# HTML report output directory
directory = htmlcov

[xml]
# XML report for CI tools
output = coverage.xml
